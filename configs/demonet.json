{
  "net": {
    "name": "WaveNet",
    "config": {
      "layers_configs": [
        {
          "input_size": 1,
          "condition_size": 1,
          "channels": 3,
          "head": {"out_channels": 2, "kernel_size": 1, "bias": false},
          "kernel_size": 3,
          "dilations": [1, 2],
          "activation": "Tanh"
        },
        {
          "condition_size": 1,
          "input_size": 3,
          "channels": 2,
          "head": {"out_channels": 1, "kernel_size": 1, "bias": true},
          "kernel_size": 3,
          "dilations": [1, 2],
          "activation": "Tanh"
        }
      ],
      "head_scale": 0.02
    }
  },
  "optimizer": {"lr": 0.004},
  "lr_scheduler": {"class": "ExponentialLR", "kwargs": {"gamma": 0.993}}
}
